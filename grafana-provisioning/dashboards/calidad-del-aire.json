      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ica"
          },
          "rawQuery": true,
          "query": "SELECT last(\"nombre\") AS \"nombre\", last(\"tipo\") AS \"tipo\", last(\"debido_a\") AS \"debido_a\", last(\"latitud\") AS \"latitud\", last(\"longitud\") AS \"longitud\", last(\"categoria_ica\") AS \"categoria_ica\", last(\"indice_original\") AS \"indice_original\" FROM \"ica_estaciones\" WHERE $timeFilter GROUP BY \"cod_estacion\"",
          "resultFormat": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Estaciones con peor calidad del aire",
      "description": "Una fila por estación; se ordena primero por la categoría ICA más alta. No son promedios provinciales.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-ica"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
