              {
                "field": "categoria_ica",
                "desc": true
              },
              {
                "field": "nombre",
                "desc": false
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ica"
          },
          "rawQuery": true,
          "query": "SELECT last(\"nombre\") AS \"nombre\", last(\"tipo\") AS \"tipo\", last(\"debido_a\") AS \"debido_a\", last(\"categoria_ica\") AS \"categoria_ica\", last(\"indice_original\") AS \"indice_original\" FROM \"ica_estaciones\" WHERE $timeFilter GROUP BY \"cod_estacion\"",
          "resultFormat": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Evolución del ICA por estación",
      "description": "Categoría ICA de cada estación a lo largo del tiempo; cada serie representa una estación individual, sin promedios.",
