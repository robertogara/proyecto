            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ica"
          },
          "rawQuery": true,
          "query": "SELECT last(\"categoria_ica\") AS \"categoria_ica\" FROM \"ica_estaciones\" WHERE $timeFilter GROUP BY time($__interval), \"cod_estacion\" fill(null)",
          "resultFormat": "time_series"
        }
      ]
    }
