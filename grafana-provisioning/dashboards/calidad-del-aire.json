              "style": {
                "color": {
                  "field": "categoria_ica",
                  "fixed": "#299c46"
                },
                "opacity": 0.9,
                "rotation": {
                  "fixed": 0
                },
                "size": {
                  "fixed": 8
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitud",
              "longitude": "longitud"
